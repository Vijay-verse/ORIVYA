# ==============================================================================
# ORIVYA — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Supabase Public API (Accessible in browser & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment Provider Sandbox (Mock / Simulated initially)
PAYMENT_PROVIDER_MODE=mock # 'mock' | 'razorpay'
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
